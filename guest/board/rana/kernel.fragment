# kernel.fragment — extra kernel CONFIG the RanA guest kernel MUST carry.
#
# Merged over the arch default by Buildroot (see rana_guest_defconfig:
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES). Every option here maps to a concrete
# RanA requirement; comments say which. These are the options the D7 hooks +
# the macOS projection (virtiofs/vsock) depend on. Missing any of these breaks
# capture in the guest.

# ============================================================================
# BTF / CO-RE — REQUIRED. bpf2go CO-RE programs need BTF in the running kernel
# (D4/D5). Without DEBUG_INFO_BTF the loader cannot relocate; capture is dead.
# ============================================================================
CONFIG_DEBUG_INFO=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_PAHOLE_HAS_SPLIT_BTF=y

# ============================================================================
# BPF core + the program/attach types the D7 hook set uses.
# ============================================================================
CONFIG_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_HAVE_EBPF_JIT=y
# Ring buffer (BPF_MAP_TYPE_RINGBUF) — the kernel->ranad transport.
CONFIG_BPF_EVENTS=y
# fentry/fexit + BPF trampolines — the resolved-path file hooks and
# unix_stream_connect fentry (D7) need these.
CONFIG_BPF_LSM=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FTRACE=y
CONFIG_DYNAMIC_FTRACE=y
CONFIG_FTRACE_SYSCALLS=y
# kprobe-multi fast path (Enhanced tier, ≥5.18).
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
# Raw tracepoints — sched_process_exec/fork/exit + cgroup_attach_task (escape
# detection, D7).
CONFIG_TRACEPOINTS=y
CONFIG_BPF_RAW_TP=y

# ============================================================================
# cgroup v2 — the whole attribution model (D6): one cgroup2 leaf = one
# session. cgroup sock_addr hooks (connect4/6, sendmsg4/6) need cgroup BPF.
# ============================================================================
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_SOCK_CGROUP_DATA=y
# cgroup_skb/egress for the port-53 DNS qname parse (D7, net.dns).
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_CGROUP_NET_PRIO=y

# ============================================================================
# Networking hooks — cgroup/connect4+6, sendmsg4+6 (BPF_CGROUP_SOCK_ADDR),
# inet_sock_set_state (flow close), AF_UNIX fentry.
# ============================================================================
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_XDP_SOCKETS=y
# tcx flow accounting (Preferred tier, ≥6.6).
CONFIG_NET_CLS_BPF=y
CONFIG_NET_ACT_BPF=y

# ============================================================================
# virtiofs + FUSE + overlayfs — the macOS filesystem projection (D15):
# granted host dirs mounted /mnt/host/<name>; overlay for guest-side layering.
# ============================================================================
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_OVERLAY_FS=y
# ext4 for the persistent host-file-backed data volume (D15).
CONFIG_EXT4_FS=y

# ============================================================================
# vsock — the host<->guest control + event stream (D15). vz routes vsock via
# Virtualization.framework; the guest side needs the virtio vsock transport.
# ============================================================================
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS_COMMON=y

# ============================================================================
# virtio plumbing the vz guest needs (block/console/mmio for the VM devices).
# ============================================================================
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y

# ============================================================================
# Namespaces / misc the recorder + agents rely on.
# ============================================================================
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
# Reproducibility: keep the kernel from embedding build host/time.
# (SOURCE_DATE_EPOCH + KBUILD_BUILD_TIMESTAMP are set by the Makefile env.)
